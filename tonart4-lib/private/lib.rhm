#lang rhombus/and_meta

// =====================================================================
// Tonart 4 -- the music instantiation of facade (Art 4), in Rhombus.
//
// For now: notes, tones, tuning, volume, note->tone, and a tone-only
// rsound realizer.  Ported from tonart3's common-practice + electronic
// libraries.
// =====================================================================

import:
  facade open
  lib("rsound/main.rkt"):
    open
    except: play          // rsound's `play` is a top-level-only macro; we
                          // shadow it below with a plain function
  lib("rsound/envelope.rkt") open
  meta:
    lib("racket/base.rkt") as rkt   // inexact->exact, in the realizer

export:
  note tone tuning volume
  music rewrite_in_music
  tones note_to_tone
  music_rsound rs_render
  play                       // a function (see below), unlike rsound's macro
  meta: note_freq embed_items

// rsound's own `play` is a macro that refuses expression context (it only
// works at a module's top level), so it can't be called from the Rhombus
// REPL, nor nested in another expression.  Wrap the underlying function
// `play/proc` so `play(snd)` works everywhere.
fun play(snd): #{play/proc}(snd)

// ---------------------------------------------------------------------
// objects
// ---------------------------------------------------------------------

define_object note       // note pitch accidental octave, e.g. `note c 0 4`
define_object tone       // tone freq
define_object tuning     // tuning kind (only `equal` / 12-TET for now)
define_object volume     // volume n

// ---------------------------------------------------------------------
// music: the standard seq-like container -- a block of items, rewritten
// and held as its `inner` (the musicxml layer builds these; other layers
// nest content in them).  `rewrite_in_music` runs rewriters inside one.
// ---------------------------------------------------------------------

define_embedding music:
  fun (expr): rewrite(body_of(expr))

meta:
  // items held inside an embedding (its rewritten inner)
  fun embed_items(e): e.group_property(#'inner) || []

// rewrite_in_music: <block of rewriters>  -- for each music in scope, run
// the rewriters seeded with its items, and rebuild it.  The `music:` template
// lives here so its head resolves to this module's `music` binding.
define_mapping_rewriter rewrite_in_music over music:
  fun (stx, m):
    def [it, ...] = rewrite_in(embed_items(m), body_of(stx))
    [set_ctxt('music: $it ; ...', get_ctxt(m))]

// ---------------------------------------------------------------------
// note -> frequency (compile-time)
// ---------------------------------------------------------------------

meta:
  fun pitch_semis(p):
    match p
    | #'c: 0
    | #'d: 2
    | #'e: 4
    | #'f: 5
    | #'g: 7
    | #'a: 9
    | #'b: 11
    | ~else: 0
  // base frequencies c4..b4, 12-tone equal temperament
  def et12 = [261.626, 277.183, 293.665, 311.127, 329.628,
              349.228, 369.994, 391.995, 415.305, 440.0, 466.164, 493.883]
  fun tuning_scale(tun): et12   // only 12-TET for now
  fun note_freq(n):
    def p = args_of(n)[0].unwrap()
    def a = args_of(n)[1].unwrap()
    def o = args_of(n)[2].unwrap()
    def scale = tuning_scale(context_ref(lookup_ctxt(), #'tuning))
    scale[(pitch_semis(p) + a) mod 12] * math.expt(2.0, o - 4)

// ---------------------------------------------------------------------
// tones -- shorthand: `tones 440 660 880` lays out one tone per beat
// ---------------------------------------------------------------------

define_rewriter tones:
  fun (expr):
    for values(acc = []) (f in args_of(expr), i in 0 ..):
      def s = Syntax.make(i)
      def e = Syntax.make(i + 1)
      def ix = Syntax.make(i)
      acc ++ ['at [interval $s $e, index $ix]: tone $f']

// ---------------------------------------------------------------------
// note->tone -- convert notes in scope to tones, via the tuning
// ---------------------------------------------------------------------

define_rewriter note_to_tone:
  fun (expr):
    def notes = context_ref_within(current_ctxt(), get_ctxt(expr), #'note)
    // emit all the tones, then delete all the notes in ONE batched instruction.
    // (Emitting a `delete_expr` per note makes the engine re-scan the whole
    // context once per note -- O(notes^2); `delete_exprs` scans once.)
    def tones = for List (n in notes):
      def freq = Syntax.make(note_freq(n))
      // the tone inherits the note's coordinates (but not its art-id)
      set_ctxt('tone $freq', remove_from_ctxt(get_ctxt(n), #'art_id))
    tones ++ [delete_exprs(notes)]

// ---------------------------------------------------------------------
// the rsound realizer: turn each tone into a windowed sound and mix them
// all, positioned by interval and scaled by surrounding volume.  Returns
// runtime code that builds (and hands back) an rsound.
//
// Every tone becomes one `[sound, start-frame]` entry and rsound's
// `assemble` sums them into a single buffer in one pass.  The old version
// padded each tone with `silence` to its start and folded the lot with
// nested `rs-overlay` -- O(n^2) in samples copied, and an n-deep syntax
// tree that was itself slow to compile.  `assemble` is O(total samples),
// and the emitted code is a flat list, so a whole program realizes fast.
// ---------------------------------------------------------------------

// synthesize + mix a batch of tone specs.  Each spec is
// `[freq, gain, dur-frames, start-frame]`; every tone becomes a hann-
// windowed sine and `assemble` sums them into one buffer in a single
// pass.  Taking the specs as *data* keeps the realizer's emitted code
// tiny (a flat list of numbers) no matter how many notes there are, so it
// compiles fast; the synthesis work happens here at run time.
fun rs_render(specs):
  def entries = for List (s in specs):
    PairList(#{rs-scale}(2, #{rs-mult}(#{hann-window}(s[2]), #{make-tone}(s[0], s[1], s[2]))), s[3])
  #{rs-scale}(0.2, #{assemble}(PairList(& entries)))

define_realizer music_rsound:
  fun (ctxt):
    def sr = 44100.0
    // read nested: tones live inside `music` embeddings (run note_to_tone
    // there, e.g. `rewrite_in_music: note_to_tone`), so descend to find them
    def tones = context_ref_all_nested(ctxt, #'tone)
    cond
    | tones.length() == 0: '#{silence}(1)'
    | ~else:
        // number literals need lexical context; borrow it from a tone
        fun lit(v): Syntax.make(v, head_id_of(tones[0]))
        // a whole number of frames (assemble wants exact-integer offsets)
        fun frames(x): lit(rkt.#{inexact->exact}(math.round(x)))
        // emit one `[freq, gain, dur, start]` spec per tone -- just numbers,
        // so the generated program is small; `rs_render` synthesizes them
        def specs = for List (t in tones):
          def freq = lit(args_of(t)[0].unwrap())
          def start = expr_start(t)
          def end = expr_end(t)
          def vs = context_ref_surrounding(ctxt, get_ctxt(t), #'volume)
          def vol = if vs.length() > 0 | args_of(vs[0])[0].unwrap() | 1
          '[$freq, $(lit(vol * 0.05)), $(frames((end - start) * sr)), $(frames(start * sr))]'
        let [spec, ...] = specs
        'rs_render([$spec, ...])'
