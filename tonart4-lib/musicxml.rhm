#lang rhombus/and_meta

// =====================================================================
// tonart4 -- musicxml -> tonart.
//
// A port of tonart3's musicxml library (the *reading* direction).  The
// XML file reader lives in `private/mxml-read.rkt`; this module holds the
// art forms and the rewriter chain that turns parsed musicxml note/rest
// forms into tonart `note`s laid out on the interval timeline inside a
// `music`.
//
// This first cut handles monophonic music (one note per beat-position);
// chords (note groups) and directions (lyrics/text) are not yet ported.
// =====================================================================

import:
  facade open
  "private/lib.rhm" open        // note, tone, ... (we emit `note`)
  meta:
    lib("tonart4/private/mxml-read.rkt") open   // parse-musicxml, at phase 1
    lib("racket/base.rkt") as rkt
    lib("shrubbery/parse.rkt") as sh            // parse direction text as tonart

export:
  // coordinates / objects the pipeline uses
  duration tie voice
  mxml_note mxml_rest music_rest time_sig divisions
  music measure mxml_measure voice_at
  mxml_chord note_group direction lyric set reset
  // rewriters
  mxml_note_to_note mxml_rest_to_rest
  extract_mxml_chords mxml_chord_to_note_group ungroup_notes
  detach_directions_from_note detach_directions_from_rest interpret_directions
  do_set
  mxml_measure_to_measure rewrite_in_music rewrite_in_measure rewrite_in_mxml_measure
  durations_to_intervals measure_to_music inline_music_seq wrap_in_music
  musicxml_to_tonart
  load_musicxml
  meta: expr_duration build_seq_like note_has_chord note_dirs parse_tonart

// ---------------------------------------------------------------------
// coordinates
// ---------------------------------------------------------------------

// duration: the raw musicxml duration of a note; carried, inner wins
define_coordinate duration:
  merge: fun (l, r, _l, _r, _c): (r || l)
  within: fun (l, r, _l, _r, _c): #true
// tie: start / stop / continue; carried
define_coordinate tie:
  merge: fun (l, r, _l, _r, _c): (r || l)
  within: fun (l, r, _l, _r, _c): #true
// voice: a subset coordinate (union on merge, subset for within?)
define_coordinate voice:
  merge:
    fun (l, r, _l, _r, _c):
      cond
      | l && r:
          block:
            let [a, ...] = dedup_terms(args_of(l) ++ args_of(r))
            'voice $a ...'
      | ~else: (r || l)
  within:
    fun (l, r, _l, _r, _c):
      def ls = args_of(l).map(fun (a): a.unwrap())
      for values(ok = #true) (x in args_of(r).map(fun (a): a.unwrap())):
        ok && (ls.filter(~keep: fun (y): y == x).length() > 0)

meta:
  fun dedup_terms(items):
    for values(acc = []) (a in items):
      if acc.filter(~keep: fun (b): b.unwrap() == a.unwrap()).length() > 0 | acc | acc ++ [a]
  // the duration value on a form, or #false
  fun expr_duration(e):
    def c = context_ref(get_ctxt(e), #'duration)
    if c | args_of(c)[0].unwrap() | #false

// ---------------------------------------------------------------------
// objects
// ---------------------------------------------------------------------

define_object mxml_note      // mxml_note p a o type [chord]   (parsed note)
define_object mxml_rest      // mxml_rest type
define_object mxml_chord     // mxml_chord [[p,a,o], ...] type  (grouped notes)
define_object note_group     // note_group [[p,a,o], ...]       (simultaneous notes)
define_object music_rest     // a tonart rest
define_object time_sig       // time_sig n d
define_object divisions      // divisions n
define_object direction      // direction "tonart-source"  (before interpreting)
define_object lyric          // lyric "syllable"
define_object set            // set <form>   -- hold a form from an instant
define_object reset          // reset        -- ends the nearest open `set`

meta:
  // the extra terms of an mxml_note, after `p a o type`
  fun note_extras(e):
    match e | 'mxml_note $_ $_ $_ $_ $x ...': [x, ...] | ~else: []
  // does an mxml_note carry a trailing `chord` marker?
  fun note_has_chord(e):
    note_extras(e).filter(~keep: fun (x): head_of(x) == #'chord).length() > 0
  // the direction strings on an mxml_note's `[dir, ...]` bracket (or [])
  fun note_dirs(e):
    def brs = note_extras(e).filter(~keep: fun (x): match x | '[$_, ...]': #true | ~else: #false)
    if brs.length() > 0 | (match brs[0] | '[$d, ...]': [d, ...]) | []
  // strip one layer of parentheses: `(x)` -> `x` (tonart3 wrote directions
  // and `set` bodies as parenthesized s-expressions)
  fun unwrap_parens(g):
    match g | '($inner)': '$inner' | ~else: g
  // parse a direction's tonart-source text into a list of art groups,
  // unwrapping each group's outer parens
  fun parse_tonart(text):
    def parsed = sh.#{parse-all}(rkt.#{open-input-string}(text))
    def gs = match parsed | '$g; ...': [g, ...] | ~else: [parsed]
    gs.map(unwrap_parens)
  // graft `ref`'s lexical scopes onto a freshly parsed group, so the art
  // names in it resolve where `ref` lives (art3's `datum->syntax stx`)
  fun regraft(ref, g):
    rkt.#{datum->syntax}(ref, rkt.#{syntax->datum}(g))
  // build an mxml_chord from a group of notes in source order (ns[0] is the
  // base note, carrying the canonical modifiers and coordinates)
  fun mxml_notes_to_chord(ns):
    def base = ns[0]
    let [md, ...]:
      match base
      | 'mxml_note $_ $_ $_ $m ...':
          // the base note's modifiers, minus any chord marker
          [m, ...].filter(~keep: fun (x): head_of(x) != #'chord)
    let [pt, ...]:
      for List (n in ns):
        match n | 'mxml_note $p $a $o $_ ...': '[$p, $a, $o]'
    set_ctxt('mxml_chord [$pt, ...] $md ...', get_ctxt(base))

// ---------------------------------------------------------------------
// embeddings: seq-like containers whose block body is rewritten and held
// ---------------------------------------------------------------------

// `music` and `embed_items` now live in the tonart standard lib
// (private/lib.rhm), imported open above.  `build_seq_like` stays here: it
// splices a bare head symbol into a `head: ...` template, so the head resolves
// in *this* module's scope, where `measure` / `mxml_measure` (and `music`, via
// lib) are bound.
define_embedding measure:
  fun (expr): rewrite(body_of(expr))
define_embedding mxml_measure:
  fun (expr): rewrite(body_of(expr))

meta:
  // rebuild an embedding form `head: item; ...` carrying src's coordinates
  fun build_seq_like(head_id, src, items):
    block:
      let [it, ...] = items
      set_ctxt('$head_id: $it ; ...', get_ctxt(src))

// voice_at [v, ...]: body   ==   at [voice v ...]: body
define_rewriter voice_at:
  fun (expr):
    match expr
    | 'voice_at [$v, ...]: $body; ...':
        ['at [voice $v ...]: $body; ...']

// ---------------------------------------------------------------------
// per-object conversions (mapping rewriters)
// ---------------------------------------------------------------------

// mxml_note p a o type ...  ->  note p a o [dir ...]  (keeping coordinates)
define_mapping_rewriter mxml_note_to_note over mxml_note:
  fun (stx, n):
    match n
    | 'mxml_note $p $a $o $_ ...':
        def dirs = note_dirs(n)
        if dirs.length() > 0
        | (block: let [d, ...] = dirs; [set_ctxt('note $p $a $o [$d, ...]', get_ctxt(n))])
        | [set_ctxt('note $p $a $o', get_ctxt(n))]

// mxml_rest ...  ->  music_rest
define_mapping_rewriter mxml_rest_to_rest over mxml_rest:
  fun (stx, r):
    [set_ctxt('music_rest', get_ctxt(r))]

// ---------------------------------------------------------------------
// directions -- pulled off notes/rests into `direction` objects at the
// note's instant, then interpreted as tonart source
// ---------------------------------------------------------------------

meta:
  // the coordinates a detached direction should carry: the note's, minus
  // its interval and id, so it sits at an instant instead of a span
  fun direction_ctxt(n):
    remove_from_ctxt(remove_from_ctxt(get_ctxt(n), #'interval), #'art_id)

// note p a o [dir ...]  ->  note p a o  +  a `direction` per dir at the start
define_mapping_rewriter detach_directions_from_note over note:
  fun (stx, n):
    match n
    | 'note $p $a $o [$d, ...]':
        def start = Syntax.make(expr_start(n) || 0)
        def base_ctxt = direction_ctxt(n)
        def dirs:
          for List (dir in [d, ...]):
            set_ctxt('at [instant $start]: direction $dir', base_ctxt)
        [set_ctxt('note $p $a $o', get_ctxt(n))] ++ dirs
    | ~else: [n]

// music_rest [dir ...]  ->  music_rest  +  a `direction` per dir
define_mapping_rewriter detach_directions_from_rest over music_rest:
  fun (stx, r):
    match r
    | 'music_rest [$d, ...]':
        def start = Syntax.make(expr_start(r) || 0)
        def base_ctxt = direction_ctxt(r)
        def dirs:
          for List (dir in [d, ...]):
            set_ctxt('at [instant $start]: direction $dir', base_ctxt)
        [set_ctxt('music_rest', get_ctxt(r))] ++ dirs
    | ~else: [r]

// direction "text"  ->  the art the text parses to, at the direction's coords
define_mapping_rewriter interpret_directions over direction:
  fun (stx, dir):
    match dir
    | 'direction $text':
        def ref = head_id_of(dir)      // resolves tonart names, hygienically
        for values(acc = []) (g in parse_tonart(text.unwrap())):
          def grafted = regraft(ref, g)
          def h = head_id_of(grafted)
          // interpret only if it names a known art form; otherwise leave
          // the direction untouched (e.g. tonart3-syntax directions)
          if h && kind_of(h)
          | acc ++ [set_ctxt(grafted, get_ctxt(dir))]
          | acc ++ [dir]

// ---------------------------------------------------------------------
// set / reset / do_set  (ported from art3's timeline lib)
//   set <form>   at an instant holds <form> from that instant until the
//   nearest following reset (or the end of the surrounding music).
//   do_set turns each `set` into that interval-spanning form.
// ---------------------------------------------------------------------

meta:
  // the form a `set` holds: `set (name theme)` or `set: name theme`
  fun set_inner(s):
    match s
    | 'set ($inner)': '$inner'
    | 'set: $g; ...': '$g; ...'
    | 'set $inner': '$inner'
    | ~else: s
  // the nearest reset instant strictly after `start`, or #false
  fun nearest_reset(start, resets):
    def afters:
      for values(acc = []) (r in resets):
        def t = expr_instant(r)
        if t && t > start | acc ++ [t] | acc
    if afters.length() > 0 | afters.sort(fun (a, b): a < b)[0] | #false
  // the greatest interval end among the notes in scope (the piece's end)
  fun piece_end(ctxt):
    for values(mx = 0) (n in ctxt):
      def e = expr_end(n)
      if e && e > mx | e | mx

define_rewriter do_set:
  fun (expr):
    def sets = context_ref_within(current_ctxt(), get_ctxt(expr), #'set)
    def resets = context_ref_within(current_ctxt(), get_ctxt(expr), #'reset)
    def the_end = expr_end(expr) || piece_end(current_ctxt())
    for values(acc = []) (s in sets):
      def start = expr_instant(s) || 0
      def stop = nearest_reset(start, resets) || the_end
      def s0 = Syntax.make(start)
      def e0 = Syntax.make(stop)
      def inner = set_inner(s)
      // the set's coordinates, minus its instant (it becomes a span now)
      def base_ctxt = remove_from_ctxt(get_ctxt(s), #'instant)
      acc ++ [delete_expr(s),
              set_ctxt('at [interval $s0 $e0]: $inner', base_ctxt)]

// extract_mxml_chords: walk the notes/rests in scope and group each run of
// a base note followed by `chord`-marked notes into one mxml_chord, giving
// each group (or lone note) a fresh index.  Runs inside a seq.
define_rewriter extract_mxml_chords:
  fun (expr):
    def items:
      current_ctxt().filter(~keep: fun (e): head_of(e) == #'mxml_note || head_of(e) == #'mxml_rest)
    // split into groups: a base note (or rest) starts a group; `chord`-marked
    // notes append to the current group
    def groups = Box([])
    def cur = Box([])
    fun close():
      when cur.value.length() > 0 | groups.value := groups.value ++ [cur.value]
    for (e in items):
      cond
      | head_of(e) == #'mxml_note && note_has_chord(e):
          cur.value := cur.value ++ [e]
      | ~else:
          close()
          cur.value := [e]
    close()
    // emit each group (single note/rest, or a chord) with its index
    let [r, ...]:
      for List (g in groups.value, idx in 0 ..):
        def ix = 'index $(Syntax.make(idx))'
        if g.length() == 1
        | put_in_id_ctxt(g[0], ix)
        | put_in_id_ctxt(mxml_notes_to_chord(g), ix)
    ['replace_full_context: $r ; ...']

// mxml_chord [[p,a,o], ...] mods  ->  note_group [[p,a,o], ...] [dir...]
// (carrying the base note's directions, if any, onto the group)
define_mapping_rewriter mxml_chord_to_note_group over mxml_chord:
  fun (stx, c):
    match c
    | 'mxml_chord [$p, ...] $m ...':
        def brs = [m, ...].filter(~keep: fun (x): match x | '[$_, ...]': #true | ~else: #false)
        if brs.length() > 0
        | (block: def db = brs[0]; [set_ctxt('note_group [$p, ...] $db', get_ctxt(c))])
        | [set_ctxt('note_group [$p, ...]', get_ctxt(c))]

// note_group [[p,a,o], ...] [dir...]  ->  the notes, all at the group's
// coordinates; the first note carries the group's directions
define_mapping_rewriter ungroup_notes over note_group:
  fun (stx, ng):
    fun note_of(p, idx, dirs):
      match p
      | '[$pp, $aa, $oo]':
          if idx == 0 && dirs.length() > 0
          | (block: let [dd, ...] = dirs; set_ctxt('note $pp $aa $oo [$dd, ...]', get_ctxt(ng)))
          | set_ctxt('note $pp $aa $oo', get_ctxt(ng))
    match ng
    | 'note_group [$pitch, ...] [$d, ...]':
        for values(acc = []) (p in [pitch, ...], idx in 0 ..):
          acc ++ [note_of(p, idx, [d, ...])]
    | 'note_group [$pitch, ...]':
        for values(acc = []) (p in [pitch, ...], idx in 0 ..):
          acc ++ [note_of(p, idx, [])]

// ---------------------------------------------------------------------
// rewrite-inside helpers (map a block of rewriters into each container)
// ---------------------------------------------------------------------

define_mapping_rewriter rewrite_in_measure over measure:
  fun (stx, m):
    [build_seq_like(#'measure, m, rewrite_in(embed_items(m), body_of(stx)))]

define_mapping_rewriter rewrite_in_mxml_measure over mxml_measure:
  fun (stx, m):
    [build_seq_like(#'mxml_measure, m, rewrite_in(embed_items(m), body_of(stx)))]

// ---------------------------------------------------------------------
// mxml_measure -> measure: convert the notes/rests inside, keep the rest
// ---------------------------------------------------------------------

define_mapping_rewriter mxml_measure_to_measure over mxml_measure:
  fun (stx, m):
    def converted:
      rewrite_in(embed_items(m),
                 ['rewrite_in_seq:
                     mxml_note_to_note
                     mxml_rest_to_rest
                     mxml_chord_to_note_group'])
    [build_seq_like(#'measure, m, converted)]

// ---------------------------------------------------------------------
// durations -> intervals: lay a seq's items out end to end by duration
// ---------------------------------------------------------------------

define_mapping_rewriter durations_to_intervals over seq:
  fun (stx, s):
    // normalize raw musicxml durations to quarter-note beats using the
    // measure's `divisions` (the number of duration units per quarter)
    def div:
      def d = context_ref(current_ctxt(), #'divisions)
      if d | args_of(d)[0].unwrap() | 1
    def ordered:
      seq_items(s).sort(fun (a, b): (expr_single_index(a) || 0) < (expr_single_index(b) || 0))
    def t = Box(0)
    for values(acc = []) (e in ordered):
      def dur = (expr_duration(e) || 0) / div
      def s0 = Syntax.make(t.value)
      def e0 = Syntax.make(t.value + dur)
      t.value := t.value + dur
      def stripped = remove_from_id_ctxt(remove_from_id_ctxt(e, #'duration), #'index)
      acc ++ ['at [interval $s0 $e0]: $stripped']

// ---------------------------------------------------------------------
// measure -> music
// ---------------------------------------------------------------------

define_mapping_rewriter measure_to_music over measure:
  fun (stx, m):
    [build_seq_like(#'music, m, embed_items(m))]

// ---------------------------------------------------------------------
// inline a seq of music blocks into a `--` timeline
// ---------------------------------------------------------------------

meta:
  fun music_end(mus):
    def items = embed_items(mus)
    for values(mx = 0) (e in items):
      def en = expr_end(e)
      if en && en > mx | en | mx

define_mapping_rewriter inline_music_seq over seq:
  fun (stx, s):
    def init_start = expr_start(s) || 0
    def ordered:
      seq_items(s).sort(fun (a, b): (expr_single_index(a) || 0) < (expr_single_index(b) || 0))
    // the seq's own coordinates (e.g. `voice`) to carry down onto the
    // notes -- everything but the timeline/id coords this rewriter resets
    def carry:
      remove_from_ctxt(remove_from_ctxt(remove_from_ctxt(get_ctxt(s), #'interval), #'index), #'art_id)
    def t = Box(init_start)
    for values(acc = []) (mus in ordered):
      def len = music_end(mus)
      def s0 = Syntax.make(t.value)
      def e0 = Syntax.make(t.value + len)
      t.value := t.value + len
      // place this music block on its own interval span, carrying the
      // seq's voice (etc.) down onto its notes
      let [it, ...] = embed_items(mus).map(fun (e): remove_from_id_ctxt(e, #'index))
      def out_ctxt = merge_coordinates(carry, get_ctxt(mus), current_ctxt())
      acc ++ [set_ctxt('at [interval $s0 $e0]: $it ; ...', out_ctxt)]

// ---------------------------------------------------------------------
// the whole musicxml -> tonart pipeline
// ---------------------------------------------------------------------

// wrap_in_music: collect the note / music_rest forms in this rewriter's own
// scope (its section, etc.) into a single `music` embedding, so the engraver
// (which reads notes *inside* a music embedding, not inline) can find them.
// The notes keep their own voice / interval; the music carries the scope.
define_rewriter wrap_in_music:
  fun (expr):
    def scope = remove_from_ctxt(get_ctxt(expr), #'art_id)
    def notes = context_ref_within(current_ctxt(), scope, #'note)
                  ++ context_ref_within(current_ctxt(), scope, #'music_rest)
    cond
    | notes.length() == 0: []
    | ~else:
        block:
          let [n, ...] = notes
          notes.map(delete_expr) ++ [set_ctxt('music: $n ; ...', scope)]

define_rewriter musicxml_to_tonart:
  fun (expr):
    ['rewrite_in_seq:
        rewrite_in_mxml_measure:
          rewrite_in_seq:
            extract_mxml_chords
        mxml_measure_to_measure
        rewrite_in_measure:
          durations_to_intervals
          ungroup_notes
        measure_to_music
     ',
     'inline_music_seq',
     'detach_directions_from_note',
     'detach_directions_from_rest',
     // keep the inlined timeline, but hold it inside a `music` embedding
     'wrap_in_music']
     // like tonart3, musicxml_to_tonart stops at detached `direction`s;
     // follow with `interpret_directions` (and then `do_set`) to fire them

// ---------------------------------------------------------------------
// load_musicxml "file" [voice ...]  -- read a MusicXML file and produce
// the parsed art forms (one `voice_at` per part, in file order, zipped
// with the given voice names).  Pair with `musicxml_to_tonart` to get
// tonart notes.  Monophonic; ties/chords/directions not yet handled.
// ---------------------------------------------------------------------

meta:
  fun mx_sym(s): Syntax.make(rkt.#{string->symbol}(s))   // "c" -> identifier c
  fun mx_num(n): Syntax.make(n)
  fun mx_ref(xs, i): rkt.#{list-ref}(xs, i)
  // one parsed note -> `at [duration d]: mxml_note p a o type` (or mxml_rest)
  // the [dir, ...] bracket of tonart-source string literals, or #false
  fun mx_dirs(n):
    def ds = mx_ref(n, 7)
    if rkt.#{null?}(ds)
    | #false
    | block:
        let [d, ...] = for List (s in ds): Syntax.make(s)
        '[$d, ...]'
  fun mx_build_note(n):
    def dur = mx_num(mx_ref(n, 5))
    def ty = mx_sym(mx_ref(n, 4) || "quarter")
    def dirs = mx_dirs(n)
    if mx_ref(n, 0)                                       // rest?
    | (if dirs
       | 'at [duration $dur]: mxml_rest $ty $dirs'
       | 'at [duration $dur]: mxml_rest $ty')
    | block:
        def st = mx_sym(mx_ref(n, 1))
        def al = mx_num(mx_ref(n, 2))
        def oc = mx_num(mx_ref(n, 3))
        def ch = mx_ref(n, 6)                             // chord?
        cond
        | ch && dirs: 'at [duration $dur]: mxml_note $st $al $oc $ty chord $dirs'
        | ch: 'at [duration $dur]: mxml_note $st $al $oc $ty chord'
        | dirs: 'at [duration $dur]: mxml_note $st $al $oc $ty $dirs'
        | ~else: 'at [duration $dur]: mxml_note $st $al $oc $ty'
  // one parsed measure -> an mxml_measure form
  fun mx_build_measure(m):
    def divisions = mx_ref(m, 0)
    def timesig = mx_ref(m, 1)
    def hdr:
      block:
        def a:
          if timesig
          | ['time_sig $(mx_num(rkt.#{car}(timesig))) $(mx_num(rkt.#{cadr}(timesig)))']
          | []
        def b:
          if divisions | ['divisions $(mx_num(divisions))'] | []
        a ++ b
    let [h, ...] = hdr
    let [nf, ...] = for List (n in mx_ref(m, 2)): mx_build_note(n)
    'mxml_measure:
       $h ; ...
       seq:
         ix__:
           $nf ; ...'
  // one part + its voice name -> a voice_at holding a seq of measures
  fun mx_build_part(vname, part):
    let [mf, ...] = for List (m in mx_ref(part, 1)): mx_build_measure(m)
    'voice_at [$vname]:
       seq:
         ix__:
           $mf ; ...'

define_rewriter load_musicxml:
  fun (expr):
    match expr
    | 'load_musicxml $f [$voice, ...]':
        // resolve the path relative to the source file doing the load
        def path = #{resolve-file}(rkt.#{syntax-source}(f), f.unwrap())
        def parts = #{parse-musicxml}(path)
        def voices = [voice, ...]
        for values(acc = []) (part in parts, v in voices):
          acc ++ [mx_build_part(v, part)]
