#lang rhombus/and_meta

// =====================================================================
// tonart4 -- the LilyPond realizer.
//
// `music_lilypond` turns the notes in scope (positioned on the interval
// timeline) into LilyPond source; `lilypond_png` / `lilypond_svg` run the
// `lilypond` CLI to engrave that source to an image file.
//
// A focused port of the compositions' lilypond realizer: single staff,
// notes + rests, pitches and (tie-split) durations.  Interval lengths are
// read as quarter-note beats.  Multi-voice staves, chords-as-one-token,
// tuplets, and bar-aware splitting are not (yet) ported.
// =====================================================================

import:
  facade open
  "private/lib.rhm" open        // note (we read `note` / music_rest)
  lib("racket/base.rkt") as rkt
  lib("racket/system.rkt") as sys
  meta:
    lib("racket/base.rkt") as mrkt
    lib("racket/system.rkt") as msys
    lib("tonart4/private/engrave-par.rkt") as mpar   // parallel engraving

export:
  music_lilypond image
  lilypond_png lilypond_svg
  meta:
    pitch_to_lily duration_to_lily notes_to_lilypond notes_to_staves
    ly_document ly_document_staves expr_voice expr_image image_markup engrave engrave_cropped
    engrave_cropped_all
    time_sig_info

// an `image "path"` hangs a picture above the staff at its interval start,
// in its voice (e.g. a danceart dancer rendered to a PNG)
define_object image

// ---------------------------------------------------------------------
// pitch + duration -> lilypond (compile-time helpers)
// ---------------------------------------------------------------------

meta:
  fun repeat_str(s, n):
    for values(acc = "") (_ in 0 .. n): acc +& s
  // tonart octave 4 = middle C = lilypond c'
  fun pitch_to_lily(p, a, o):
    def base = to_string(p)
    def acc:
      match a
      | 1: "is"
      | -1: "es"
      | 2: "isis"
      | -2: "eses"
      | ~else: ""
    def oct:
      cond
      | o >= 4: repeat_str("'", o - 3)
      | o < 3: repeat_str(",", 3 - o)
      | ~else: ""
    base +& acc +& oct

  // basic durations, in thirty-second-note units, longest first (so a note as
  // short as a 32nd -- a 1/8-beat -- engraves, not just down to a 16th)
  def basic_durs = [[32, "1"], [24, "2."], [16, "2"], [12, "4."],
                    [8, "4"], [6, "8."], [4, "8"], [3, "16."], [2, "16"], [1, "32"]]
  // a whole number of thirty-seconds -> list of lilypond duration strings
  // (tied together when it isn't a single (dotted) value)
  fun units_to_lily(units):
    fun loop(remaining, acc):
      cond
      | remaining <= 0: acc
      | ~else:
          def m:
            for values(found = #false) (d in basic_durs):
              if !found && d[0] <= remaining | d | found
          if m
          | loop(remaining - m[0], acc ++ [m[1]])
          | acc ++ ["32"]                // fallback, avoid looping
    loop(units, [])
  // a duration in quarter notes -> lilypond duration strings
  fun duration_to_lily(dur): units_to_lily(math.round(dur * 8))
  // bar-aware: split `dur` (quarters) starting at absolute `start`
  // (quarters) so no piece crosses a barline of length `bar_len`
  fun duration_to_lily_bar(dur, start, bar_len):
    def bar = math.round(bar_len * 8)
    def bar_pos = math.round(start * 8) mod bar
    fun loop(remaining, pos, acc):
      cond
      | remaining <= 0: acc
      | ~else:
          def to_end = bar - pos
          def chunk = if remaining < to_end | remaining | to_end
          loop(remaining - chunk, 0, acc ++ units_to_lily(chunk))
    loop(math.round(dur * 8), bar_pos, [])

// ---------------------------------------------------------------------
// the realizer: notes/rests in scope -> a LilyPond document (string)
// ---------------------------------------------------------------------

meta:
  // one note/rest -> a lilypond token like `c'4` or `c'2~ c'8` or `r4`,
  // split at barlines of length `bar_len` (quarters)
  fun note_token(e, bar_len):
    def start = expr_start(e) || 0
    def dur = (expr_end(e) || 0) - start
    def durs = duration_to_lily_bar(dur, start, bar_len)
    def head:
      match e
      | 'note $p $a $o $_ ...': pitch_to_lily(p.unwrap(), a.unwrap(), o.unwrap())
      | ~else: "r"                       // music_rest (or anything else)
    // tie the pieces: pitch+dur1 ~ pitch+dur2 ...
    for values(acc = "") (d in durs, i in 0 ..):
      if i == 0 | head +& d | acc +& "~ " +& head +& d

  // the "path" of an `image` form
  fun expr_image(e):
    match e | 'image $p': p.unwrap() | ~else: ""
  // does `path` end with `suffix`?
  fun ends_with(path, suffix):
    def pl = path.length()
    def sl = suffix.length()
    pl >= sl && path.substring(pl - sl, pl) == suffix
  // lilypond markup that hangs `path` above the note it is attached to;
  // \epsfile for EPS (transparent, correct colours), \image for PNG
  fun image_markup(path):
    def cmd = if ends_with(path, ".eps") | "\\epsfile" | "\\image"
    "^\\markup { \\override #'(background-color . #f) \\with-dimensions #'(-2 . 2) #'(0 . 6) \\center-align "
      +& cmd +& " #Y #6 #\"" +& path +& "\" }"

  // is `e` a note (vs a rest)?
  fun is_note(e): match e | 'note $_ ...': #true | ~else: #false
  // the distinct start times among `events`, in ascending order
  fun starts_of(events):
    def ss:
      for values(acc = []) (e in events):
        def s = expr_start(e) || 0
        if acc.filter(~keep: fun (x): x == s).length() > 0 | acc | acc ++ [s]
    ss.sort(fun (a, b): a < b)
  // several notes sharing a start (and duration) -> one lilypond chord
  // `<c' e' g'>4`, split at barlines and tied like a single note
  fun chord_token(notes, bar_len):
    def start = expr_start(notes[0]) || 0
    def dur = (expr_end(notes[0]) || 0) - start
    def durs = duration_to_lily_bar(dur, start, bar_len)
    def inside:
      for values(acc = "") (n in notes, i in 0 ..):
        def h:
          match n | 'note $p $a $o $_ ...': pitch_to_lily(p.unwrap(), a.unwrap(), o.unwrap()) | ~else: ""
        if i == 0 | h | acc +& " " +& h
    def chord = "<" +& inside +& ">"
    for values(acc = "") (d in durs, i in 0 ..):
      if i == 0 | chord +& d | acc +& "~ " +& chord +& d

  // a list of note/rest forms -> the staff body, ordered by start, with
  // same-start notes emitted as a single chord
  fun notes_to_lilypond(events, bar_len = 4):
    for values(acc = "") (s in starts_of(events), i in 0 ..):
      def group = events.filter(~keep: fun (e): (expr_start(e) || 0) == s)
      def notes = group.filter(~keep: is_note)
      def tok = if notes.length() > 1 | chord_token(notes, bar_len) | note_token(group[0], bar_len)
      if i == 0 | tok | acc +& " " +& tok

  // invisible spacer skips spanning `dur` quarters, the first carrying
  // `mark` (so a markup lands exactly at the skip's start)
  fun skip_tokens(dur, mark):
    for values(acc = "") (d in duration_to_lily(dur), i in 0 ..):
      def tok = "s" +& d +& (if i == 0 | mark | "")
      if acc == "" | tok | acc +& " " +& tok
  // a parallel voice of skips that places each image at its exact beat:
  // a markup-less lead-in to the first image, then one skip per image
  // running to the next image's start (art3's "dance voice")
  fun image_skip_voice(imgs, voice_end):
    def sorted = imgs.sort(fun (a, b): (expr_start(a) || 0) < (expr_start(b) || 0))
    def n = sorted.length()
    def t0 = expr_start(sorted[0]) || 0
    def lead = if t0 > 0 | skip_tokens(t0, "") +& " " | ""
    def rest:
      for values(acc = "") (im in sorted, i in 0 ..):
        def s = expr_start(im) || 0
        def nxt = if i + 1 < n | (expr_start(sorted[i + 1]) || 0) | voice_end
        def dur = if nxt > s | nxt - s | 1
        def seg = skip_tokens(dur, image_markup(expr_image(im)))
        if acc == "" | seg | acc +& " " +& seg
    lead +& rest
  // the voice id-path of a form (a list of symbols), or []
  fun expr_voice(e):
    def c = context_ref(get_ctxt(e), #'voice)
    if c | args_of(c).map(fun (a): a.unwrap()) | []
  // the octave of a note form, or #false
  fun expr_octave(e):
    match e | 'note $_ $_ $o $_ ...': o.unwrap() | ~else: #false
  // pick a clef from the notes' average register (bass below middle C)
  fun clef_for(events):
    def octs = events.map(expr_octave).filter(~keep: fun (o): o)
    cond
    | octs.length() == 0: "treble"
    | ~else:
        def avg = (for values(s = 0) (o in octs): s + o) / octs.length()
        if avg < 3.5 | "bass" | "treble"
  // the distinct voices among `events`, in first-appearance order
  fun voices_of(events):
    for values(acc = []) (e in events):
      def v = expr_voice(e)
      if acc.filter(~keep: fun (x): x == v).length() > 0 | acc | acc ++ [v]
  // one `\new Staff { ... }` per voice among `events` (single staff when
  // unvoiced), each with a register-appropriate clef
  fun notes_to_staves(events, bar_len = 4, imgs = [], time_str = #false):
    def tprefix = if time_str | "\\time " +& time_str +& " " | ""
    for values(acc = "") (v in voices_of(events ++ imgs)):
      def vnotes = events.filter(~keep: fun (e): expr_voice(e) == v)
      def vimgs = imgs.filter(~keep: fun (e): expr_voice(e) == v)
      def notevoice = notes_to_lilypond(vnotes, bar_len)
      // images ride a parallel skip voice so each lands on its own beat,
      // rather than gluing onto whatever notehead happens to be near
      def body:
        if vimgs.length() > 0
        | (block:
             def vend = for values(mx = 0) (e in vnotes): def en = expr_end(e); if en && en > mx | en | mx
             "<< { " +& notevoice +& " } { " +& image_skip_voice(vimgs, vend) +& " } >>")
        | notevoice
      acc +& "    \\new Staff { \\clef " +& clef_for(vnotes) +& " " +& tprefix +& body +& " }\n"
  // [bar-length-in-quarters, "n/d"] for a `time_sig n d` form, or [4, #false]
  fun time_sig_info(ts):
    if ts
    | (block:
         def n = args_of(ts)[0].unwrap()
         def d = args_of(ts)[1].unwrap()
         [n * 4 / d, to_string(n) +& "/" +& to_string(d)])
    | [4, #false]
  // the bar length (in quarters) from a `time_sig n d` in scope, else 4
  fun bar_length(ctxt):
    time_sig_info(context_ref(ctxt, #'time_sig))[0]
  fun ly_staves(ctxt):
    notes_to_staves(context_ref_all(ctxt, #'note) ++ context_ref_all(ctxt, #'music_rest),
                    bar_length(ctxt),
                    context_ref_all(ctxt, #'image))
  fun ly_body(ctxt):
    notes_to_lilypond(context_ref_all(ctxt, #'note) ++ context_ref_all(ctxt, #'music_rest),
                      bar_length(ctxt))
  // a complete LilyPond document wrapping already-built staff text
  fun ly_document_staves(staves):
    "\\version \"2.24.0\"\n\\score {\n  <<\n" +& staves +& "  >>\n  \\layout { }\n}\n"
  // wrap a single staff body in a complete document
  fun ly_document(body):
    ly_document_staves("    \\new Staff { \\clef treble " +& body +& " }\n")
  // engrave LilyPond `source` to `dir/name.fmt` at compile time; returns
  // that path (fmt = "png" or "svg")
  fun engrave(source, dir, name, fmt):
    def ly_path = dir +& "/" +& name +& ".ly"
    def f = mrkt.#{open-output-file}(ly_path, ~exists: #'replace)
    mrkt.#{write-string}(source, f)
    mrkt.#{close-output-port}(f)
    msys.#{system}("lilypond --" +& fmt +& " -dresolution=200 -o "
                     +& dir +& "/" +& name +& " " +& ly_path)
    dir +& "/" +& name +& "." +& fmt
  // like `engrave`, but with `-dcrop` so the image is trimmed tight to the
  // music (no page whitespace) -- for placing a score inside a slide/pict.
  // Returns the `.cropped.<fmt>` path lilypond writes.
  fun engrave_cropped(source, dir, name, fmt):
    def ly_path = dir +& "/" +& name +& ".ly"
    def f = mrkt.#{open-output-file}(ly_path, ~exists: #'replace)
    mrkt.#{write-string}(source, f)
    mrkt.#{close-output-port}(f)
    msys.#{system}("lilypond --" +& fmt +& " -dcrop=#t -dresolution=200 -o "
                     +& dir +& "/" +& name +& " " +& ly_path)
    dir +& "/" +& name +& ".cropped." +& fmt
  // engrave many cropped PNGs at once, in parallel.  `jobs` is a list of
  // [source, dir, name]; returns their `.cropped.png` paths, in order.
  fun engrave_cropped_all(jobs):
    def racket_jobs = PairList(& jobs.map(fun (j): PairList(j[0], j[1], j[2])))
    [& mpar.#{engrave-all-cropped}(racket_jobs)]

define_realizer music_lilypond:
  fun (ctxt): ly_document_staves(ly_staves(ctxt))

// ---------------------------------------------------------------------
// running lilypond (runtime)
// ---------------------------------------------------------------------

// realize `prog`-produced source to a file `name.ly` in `dir`, then run
// lilypond to engrave it; returns the produced image path.  `fmt` is
// "png" or "svg".
fun lilypond_render(source, dir, name, fmt):
  def ly_path = dir +& "/" +& name +& ".ly"
  def out = dir +& "/" +& name
  def f = rkt.#{open-output-file}(ly_path, ~exists: #'replace)
  rkt.#{write-string}(source, f)
  rkt.#{close-output-port}(f)
  def ok = sys.#{system}("lilypond --" +& fmt +& " -dresolution=200 -o "
                           +& out +& " " +& ly_path)
  out +& "." +& fmt
fun lilypond_png(source, dir, name): lilypond_render(source, dir, name, "png")
fun lilypond_svg(source, dir, name): lilypond_render(source, dir, name, "svg")
// the lilypond source string for the notes -- convenience alias so a
// caller can name the realizer result plainly
fun lilypond_source(s): s
